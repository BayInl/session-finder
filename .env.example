# Copy to .env (gitignored) only to opt in to sending redacted transcript
# excerpts to an OpenAI-compatible HTTPS endpoint (plain HTTP is localhost-only).
SESSION_FINDER_LLM_PROVIDER=openai
SESSION_FINDER_LLM_BASE_URL=https://relay.example:13444/v1
SESSION_FINDER_LLM_API_KEY=
SESSION_FINDER_LLM_MODEL=gpt-5.6-luna
SESSION_FINDER_LLM_TIMEOUT=90
SESSION_FINDER_LLM_MAX_REQUEST_BYTES=1048576
SESSION_FINDER_LLM_MAX_OUTPUT_TOKENS=2048
SESSION_FINDER_LLM_MAX_CALLS=16
SESSION_FINDER_LLM_MAX_TOTAL_TOKENS=100000
SESSION_FINDER_LLM_SEGMENT=auto
SESSION_FINDER_LLM_JUDGE=auto

# Generic OPENAI_*/LLM_* variables (and CLIRELAY_API_KEY) are ignored unless
# SESSION_FINDER_LLM_PROVIDER=openai (or legacy LLM_PROVIDER=openai) explicitly
# opts in; their use prints one warning. Prefer SESSION_FINDER_LLM_* above.
